# Copie para ".env" na raiz do projeto antes de rodar "docker compose up --build".
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=access_control

# OBRIGATÓRIO: mínimo 32 caracteres.
JWT_SECRET=troque-por-um-texto-secreto-com-mais-de-32-caracteres
JWT_EXPIRES_IN=1h

# Portas expostas no computador (opcional)
FRONTEND_PORT=8080
BACKEND_PORT=3000
