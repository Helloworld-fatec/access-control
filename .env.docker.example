# Copie para ".env" na raiz do projeto antes de rodar "docker compose up --build".
# O arquivo .env NUNCA vai para o Git (está no .gitignore). Não há senha nem segredo padrão:
# o Compose se recusa a subir enquanto as duas linhas OBRIGATÓRIAS abaixo estiverem vazias.

# OBRIGATÓRIO. Use só letras e números (caracteres como @ # / : quebram a URL do banco).
POSTGRES_PASSWORD=
POSTGRES_USER=postgres
POSTGRES_DB=access_control

# OBRIGATÓRIO, mínimo 32 caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Portas expostas no computador (opcional)
FRONTEND_PORT=8080
BACKEND_PORT=3000
