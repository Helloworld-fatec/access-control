# Conexão com o PostgreSQL (local, Docker ou Neon).
# Neon: use o host direto (sem "-pooler") e termine com ?sslmode=require
DATABASE_URL="postgresql://usuario:senha@localhost:5432/meu_banco?schema=public"
PORT=3000

# OBRIGATÓRIO, com no mínimo 32 caracteres. Sem isso o backend não inicia.
# Gere um valor com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-um-texto-secreto-com-mais-de-32-caracteres"
JWT_EXPIRES_IN=1h

# Opcionais (valores padrão)
# PHOTOS_DIR=photos
# MAX_PHOTO_BYTES=102400
# BCRYPT_ROUNDS=10
