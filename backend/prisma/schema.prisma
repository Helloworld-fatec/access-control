// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}



// ───────────── Usuários e credenciais ─────────────

model user {
  id           String   @id @default(uuid())
  name         String
  document     String?  @unique
  email        String   @unique
  phone        String?
  passwordHash String
  role         String   // Validado pelo DTO com Zod
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  nfcTags        nfctag[]
  nfcCredential  nfccredential?
  nfcEnrollments nfcEnrollment[]
  faceTemplate   facetemplate?
  photo          userphoto?
  authorizations authorization[] @relation("authorization_user")
  createdAuths   authorization[] @relation("authorization_created_by")
  canceledAuths  authorization[] @relation("authorization_canceled_by")
  accessLogs     accesslog[]
  visits         visit[] @relation("visit_user")
  closedVisits   visit[] @relation("visit_checkout_actor")
  pokemonCollection userPokemon[]

  @@index([role, active])
  @@map("users")
}

model NfcTag {
  id        String   @id @default(uuid())
  uid       String   @unique // hexadecimal em maiúsculas, padronizado
  userId    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  user user @relation(fields: [userId], references: [id], onDelete: Cascade, map: "nfc_tags_user_id_fkey")
  credential nfccredential?

  @@index([userId], map: "nfc_tags_user_id_idx")
  @@map("nfc_tags")
}

model nfccredential {
  userId    String   @id
  codeHex   String   @unique @db.VarChar(6)
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  tagId     String?  @unique

  user user @relation(fields: [userId], references: [id], onDelete: Cascade, map: "nfc_credentials_user_id_fkey")
  tag  nfctag? @relation(fields: [tagId], references: [id], onDelete: SetNull)

  @@map("nfc_credentials")
}

model nfcEnrollment {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String
  terminalId  String
  expectedUid String?
  status      String   @default("PENDING")
  reason      String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  user     user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  terminal terminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("nfc_enrollments")
}

model facetemplate {
  id           String   @id @default(uuid())
  userId       String   @unique(map: "face_templates_user_id_key")
  embedding    Float[] // vetor (ex.: 128 floats), nunca a imagem
  modelVersion String // invalida embeddings se o modelo mudar
  consentAt    DateTime // aceite do termo (LGPD)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user user @relation(fields: [userId], references: [id], onDelete: Cascade, map: "face_templates_user_id_fkey")

  @@map("face_templates")
}

model UserPhoto {
  id        String   @id @default(uuid())
  userId    String   @unique(map: "user_photos_user_id_key")
  filePath  String // caminho relativo dentro de PHOTOS_DIR
  mimeType  String   @default("image/jpeg")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  user user @relation(fields: [userId], references: [id], onDelete: Cascade, map: "user_photos_user_id_fkey")

  @@map("user_photos")
}

// ───────────── Locais e terminais ─────────────

model location {
  id          String  @id @default(uuid())
  building    String
  entrance    String? // portaria
  door        String?
  turnstile   String? // catraca
  description String?

  terminals      terminal[]
  authorizations authorization[]
  visits         visit[]

  @@unique([building, entrance, door, turnstile], map: "locations_building_entrance_door_turnstile_key")
  @@map("locations")
}

model terminal {
  id             String    @id @default(uuid())
  name           String
  locationId     String
  latitude       Float // coordenada fixa (GPS simulado)
  longitude      Float
  qrSecret       String // segredo para assinar o token do QR
  apiKeyHash     String   @unique(map: "terminals_api_key_hash_key")
  online         Boolean   @default(false)
  lastPresenceAt DateTime?
  lastSeenAt     DateTime?
  mqttPresenceAt DateTime?
  mqttDoorState  String?
  mqttDoorStateAt DateTime?
  createdAt      DateTime  @default(now())

  location   location   @relation(fields: [locationId], references: [id], map: "terminals_location_id_fkey")
  accessLogs accesslog[]
  qrNonces   qrnonce[]
  nfcEnrollments nfcEnrollment[]
  mqttDoorCommands mqttDoorCommand[]
  visits           visit[]

  @@index([locationId], map: "terminals_location_id_idx")
  @@map("terminals")
}

// ───────────── Autorizações ─────────────

model authorization {
  id           String   @id @default(uuid())
  userId       String
  locationId   String
  startDate    DateTime @db.Date
  endDate      DateTime @db.Date
  startTime    String
  endTime      String
  maxUses      Int?
  usedCount    Int      @default(0)
  status       String   @default("ACTIVE")
  createdById  String
  canceledAt   DateTime?
  canceledById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       user     @relation("authorization_user", fields: [userId], references: [id], onDelete: Cascade, map: "authorizations_user_id_fkey")
  location   location @relation(fields: [locationId], references: [id], map: "authorizations_location_id_fkey")
  createdBy  user     @relation("authorization_created_by", fields: [createdById], references: [id], map: "authorizations_created_by_id_fkey")
  canceledBy user?    @relation("authorization_canceled_by", fields: [canceledById], references: [id], map: "authorizations_canceled_by_id_fkey")
  accessLogs AccessLog[]

  @@index([userId, locationId, status], map: "authorizations_user_location_status_idx")
  @@index([endDate], map: "authorizations_end_date_idx")
  @@map("authorizations")
}


// ───────────── Histórico e anti-replay ─────────────

model AccessLog {
  id              String   @id @default(uuid())
  userId          String?
  terminalId      String
  authorizationId String?
  method          String
  result          String
  reason          String?
  nfcUid          String?
  confidence      Float?
  distanceMeters  Float?
  commandAcked    Boolean?
  faceAttemptId   String?  @db.Uuid
  createdAt       DateTime @default(now())

  user          user?          @relation(fields: [userId], references: [id], onDelete: SetNull, map: "access_logs_user_id_fkey")
  terminal      terminal       @relation(fields: [terminalId], references: [id], map: "access_logs_terminal_id_fkey")
  authorization authorization? @relation(fields: [authorizationId], references: [id], onDelete: SetNull, map: "access_logs_authorization_id_fkey")
  mqttDoorCommand mqttDoorCommand?
  entryVisit      visit?

  @@index([createdAt], map: "access_logs_created_at_idx")
  @@index([userId, createdAt], map: "access_logs_user_created_at_idx")
  @@index([terminalId, createdAt], map: "access_logs_terminal_created_at_idx")
  @@unique([terminalId, faceAttemptId], map: "access_logs_terminal_face_attempt_key")
  @@map("access_logs")
}

enum VisitCheckoutType {
  SIMPLE
  POKEMON
}

model visit {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String?
  locationId      String
  entryTerminalId String
  entryLogId      String             @unique
  enteredAt       DateTime
  exitedAt        DateTime?
  checkoutType    VisitCheckoutType?
  checkedOutById  String?

  user          user?     @relation("visit_user", fields: [userId], references: [id], onDelete: SetNull)
  checkedOutBy  user?     @relation("visit_checkout_actor", fields: [checkedOutById], references: [id], onDelete: SetNull)
  location      location  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  entryTerminal terminal  @relation(fields: [entryTerminalId], references: [id], onDelete: Restrict)
  entryLog      accesslog @relation(fields: [entryLogId], references: [id], onDelete: Restrict)
  pokemonDraw   visitPokemonDraw?
  checkoutDoorCommand mqttDoorCommand?

  // A migration SQL garante uma única visita aberta por usuário e local.
  @@index([exitedAt, enteredAt])
  @@index([locationId, exitedAt, enteredAt])
  @@map("visits")
}

model visitPokemonDraw {
  visitId   String   @id @db.Uuid
  pokemonId String   @db.VarChar(3)
  drawnAt   DateTime @default(now())

  visit      visit        @relation(fields: [visitId], references: [id], onDelete: Cascade)
  collection userPokemon?

  @@unique([visitId, pokemonId])
  @@map("visit_pokemon_draws")
}

model userPokemon {
  visitId   String   @id @db.Uuid
  userId    String
  pokemonId String   @db.VarChar(3)
  claimedAt DateTime @default(now())

  draw visitPokemonDraw @relation(fields: [visitId, pokemonId], references: [visitId, pokemonId], onDelete: Cascade)
  user user             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([visitId, pokemonId])
  @@index([userId, claimedAt])
  @@map("user_pokemon")
}

model mqttDoorCommand {
  id          String   @id @default(uuid()) @db.Uuid
  accessLogId String?  @unique
  checkoutVisitId String? @unique @db.Uuid
  terminalId  String
  issuedAt    DateTime
  expiresAt   DateTime
  ackResult   String?
  ackAt       DateTime?

  accessLog accesslog? @relation(fields: [accessLogId], references: [id], onDelete: Cascade)
  checkoutVisit visit? @relation(fields: [checkoutVisitId], references: [id], onDelete: Cascade)
  terminal  terminal  @relation(fields: [terminalId], references: [id], onDelete: Restrict)

  @@index([ackResult, expiresAt])
  @@map("mqtt_door_commands")
}

model mqttNfcRequest {
  terminalId  String
  requestId   String   @db.Uuid
  fingerprint String
  expiresAt   DateTime
  decision    Json?

  @@id([terminalId, requestId])
  @@index([expiresAt])
  @@map("mqtt_nfc_requests")
}

model qrnonce {
  nonce      String   @id // SHA-256 do token QR; nunca guardar o token em claro
  terminalId String
  expiresAt  DateTime
  consumedAt DateTime?

  terminal terminal @relation(fields: [terminalId], references: [id], onDelete: Cascade, map: "qr_nonces_terminal_id_fkey")

  @@index([expiresAt], map: "qr_nonces_expires_at_idx") // para limpeza periódica
  @@map("qr_nonces")
}
