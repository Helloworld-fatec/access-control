// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}



// ───────────── Usuários e credenciais ─────────────

model User {
  id           String   @id @default(uuid())
  name         String
  document     String?  @unique
  email        String   @unique
  phone        String?
  passwordHash String
  role         String   // Validado pelo DTO com Zod
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  nfcTags        NfcTag[]
  faceTemplate   FaceTemplate?
  photo          UserPhoto?
  authorizations Authorization[] @relation("AuthorizationUser")
  createdAuths   Authorization[] @relation("AuthorizationCreatedBy")
  canceledAuths  Authorization[] @relation("AuthorizationCanceledBy")
  accessLogs     AccessLog[]

  @@index([role, active])
  @@map("users")
}

model NfcTag {
  id        String   @id @default(uuid())
  uid       String   @unique // hexadecimal em maiúsculas, padronizado
  userId    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FaceTemplate {
  id           String   @id @default(uuid())
  userId       String   @unique
  embedding    Float[] // vetor (ex.: 128 floats), nunca a imagem
  modelVersion String // invalida embeddings se o modelo mudar
  consentAt    DateTime // aceite do termo (LGPD)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPhoto {
  id        String   @id @default(uuid())
  userId    String   @unique
  filePath  String // caminho relativo dentro de PHOTOS_DIR
  mimeType  String   @default("image/jpeg")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────── Locais e terminais ─────────────

model Location {
  id          String  @id @default(uuid())
  building    String
  entrance    String? // portaria
  door        String?
  turnstile   String? // catraca
  description String?

  terminals      Terminal[]
  authorizations Authorization[]

  @@unique([building, entrance, door, turnstile])
}

model Terminal {
  id             String    @id @default(uuid())
  name           String
  locationId     String
  latitude       Float // coordenada fixa (GPS simulado)
  longitude      Float
  qrSecret       String // segredo para assinar o token do QR
  apiKeyHash     String // autentica o mobile-readings
  online         Boolean   @default(false)
  lastPresenceAt DateTime?
  lastSeenAt     DateTime?
  createdAt      DateTime  @default(now())

  location   Location    @relation(fields: [locationId], references: [id])
  accessLogs AccessLog[]
  qrNonces   QrNonce[]

  @@index([locationId])
}

// ───────────── Autorizações ─────────────

model Authorization {
  id           String   @id @default(uuid())
  userId       String
  locationId   String
  startDate    DateTime @db.Date
  endDate      DateTime @db.Date
  startTime    String
  endTime      String
  maxUses      Int?
  usedCount    Int      @default(0)
  status       String   @default("ACTIVE")
  createdById  String
  canceledAt   DateTime?
  canceledById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User     @relation("AuthorizationUser", fields: [userId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id])
  createdBy  User     @relation("AuthorizationCreatedBy", fields: [createdById], references: [id])
  canceledBy User?    @relation("AuthorizationCanceledBy", fields: [canceledById], references: [id])
  accessLogs AccessLog[]

  @@index([userId, locationId, status])
  @@index([endDate])
}


// ───────────── Histórico e anti-replay ─────────────

model AccessLog {
  id              String   @id @default(uuid())
  userId          String?
  terminalId      String
  authorizationId String?
  method          String
  result          String
  reason          String?
  nfcUid          String?
  confidence      Float?
  distanceMeters  Float?
  commandAcked    Boolean?
  createdAt       DateTime @default(now())

  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  terminal      Terminal       @relation(fields: [terminalId], references: [id])
  authorization Authorization? @relation(fields: [authorizationId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([terminalId, createdAt])
}

model QrNonce {
  nonce      String   @id // SHA-256 do token QR; nunca guardar o token em claro
  terminalId String
  expiresAt  DateTime
  consumedAt DateTime?

  terminal Terminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)

  @@index([expiresAt]) // para limpeza periódica
}
