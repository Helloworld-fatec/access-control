# Credenciais locais de desenvolvimento. Substitua antes de qualquer uso compartilhado.
POSTGRES_DB=access_control
POSTGRES_USER=access_control
POSTGRES_PASSWORD=access_control_dev_password
POSTGRES_PORT=5432

# Chave de exemplo apenas para desenvolvimento local; use uma chave privada forte fora dele.
JWT_SECRET=dev_only_change_this_secret_key_to_a_long_random_value
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=10
MAX_PHOTO_BYTES=102400
# Pasta de fotos ao executar o backend diretamente. O Compose usa /app/uploads.
PHOTOS_DIR=uploads
FACE_RECOGNITION_TIMEOUT_MS=5000

# Conta de demonstração do Mobile Registry. O Compose não cria a conta ao subir.
# Carregue estas variáveis no shell e execute:
# docker compose exec -e ADMIN_EMAIL -e ADMIN_PASSWORD backend npm run admin:create
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin123
