# Backend usado pelo proxy do Vite em desenvolvimento.
BACKEND_URL=http://localhost:3000

# Opcional: URL absoluta da API. Se vazio, o front usa /api (proxy).
# VITE_API_URL=

# Enquanto o backend não tem POST /auth/login, o login entra "em modo de
# desenvolvimento" (sem senha). Coloque false para desligar.
# VITE_DEV_AUTH=true
